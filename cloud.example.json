{
  "base_url": "https://YOUR-PROVIDER.example/v1",
  "model": "YOUR-MODEL",
  "api_key_env": "PVZ_API_KEY",
  "structured_output": true,
  "decision_mode": "pause_think",
  "advance_after_decision_ms": 1000,
  "prompt_file": "prompts/cloud_framework.md",
  "style_file": "prompts/play_style.json",
  "history_encoding": "board",
  "fact_memory": true,
  "strategy_memory": true,
  "memory_max_events": 20,
  "strategy_max_chars": 400,
  "timeout_s": 10,
  "min_interval_s": 1,
  "max_observation_age_ms": 5000,
  "max_requests": 600,
  "max_input_tokens": 32768,
  "context_window_tokens": null,
  "provider_max_output_tokens": null,
  "retry_output_tokens": 16384,
  "consecutive_failure_limit": 3,
  "max_total_tokens": 1000000,
  "max_output_tokens": 256,
  "token_limit_field": "max_completion_tokens"
}
