{
  "base_url": "https://api.deepseek.com",
  "model": "deepseek-flash",
  "api_key_env": "PVZ_API_KEY",
  "structured_output": false,
  "thinking": "enabled",
  "reasoning_effort": "high",
  "decision_mode": "pause_think",
  "advance_after_decision_ms": 1000,
  "prompt_file": "prompts/cloud_framework.md",
  "style_file": "prompts/play_style.json",
  "compact_context": false,
  "history_encoding": "board",
  "fact_memory": true,
  "strategy_memory": true,
  "memory_max_events": 20,
  "strategy_max_chars": 400,
  "repair_invalid_reply": true,
  "timeout_s": 120,
  "min_interval_s": 1,
  "max_observation_age_ms": 5000,
  "max_requests": 300,
  "max_total_tokens": 3000000,
  "max_output_tokens": 8192,
  "token_limit_field": "max_tokens"
}
